{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Topo Editor",
  "version": "0.1.0",
  "identifier": "com.topo-reconstruct.editor",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Topo Editor", "width": 1400, "height": 900, "minWidth": 900, "minHeight": 600 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
